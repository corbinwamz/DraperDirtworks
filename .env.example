# Owner notification on new applications. Both RESEND_API_KEY and
# NOTIFY_EMAIL_TO must be set or the notification is skipped silently.
# NOTIFY_EMAIL_FROM defaults to Resend's shared onboarding@resend.dev sender;
# switch it to notifications@<your domain> once the domain is verified in
# Resend (DKIM + SPF records added).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
